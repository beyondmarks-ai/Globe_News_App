#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Environment files (commit only the safe template)
.env.*
!.env.example

# Python / Azure Functions
**/__pycache__/
**/*.py[cod]
**/.python_packages/
**/.venv/
**/venv/
**/local.settings.json
.azure/

# Android signing and service credentials
**/key.properties
**/*.keystore
**/*.jks
**/google-services.json

# Local archives and deployment artifacts
*.zip
*.tar
*.tar.gz
